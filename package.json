{
  "name": "@johnmorrisdotca/senshu-jerseys",
  "version": "0.34.0",
  "description": "Senshu Jerseys 選手 — Sports jerseys and judogi as SVG for JavaScript: hockey, baseball, basketball, football, soccer, rugby and handball cuts, sweaters, kits, caps, helmets and retired-number banners, front and back, in stripes, hoops, halves and pinstripes, with numbers and names drawn as vectors, optional 2.5D turning and a custom element. Zero dependencies.",
  "keywords": [
    "jersey",
    "sweater",
    "kit",
    "uniform",
    "sports",
    "hockey",
    "baseball",
    "basketball",
    "football",
    "soccer",
    "rugby",
    "cap",
    "helmet",
    "retired-number",
    "banner",
    "svg",
    "turntable",
    "custom-element",
    "web-component",
    "accessible",
    "typescript",
    "javascript",
    "zero-dependencies",
    "browser",
    "node",
    "itsutsu"
  ],
  "homepage": "https://johnmorrisdotca.github.io/senshu-jerseys/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnmorrisdotca/senshu-jerseys.git"
  },
  "bugs": {
    "url": "https://github.com/johnmorrisdotca/senshu-jerseys/issues"
  },
  "author": "John Morris",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/element-define.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./turn": {
      "types": "./dist/turn-entry.d.ts",
      "import": "./dist/turn-entry.js",
      "default": "./dist/turn-entry.js"
    },
    "./element": {
      "types": "./dist/element-entry.d.ts",
      "import": "./dist/element-entry.js",
      "default": "./dist/element-entry.js"
    },
    "./brush-kana": {
      "types": "./dist/brushKana-entry.d.ts",
      "import": "./dist/brushKana-entry.js",
      "default": "./dist/brushKana-entry.js"
    },
    "./define": {
      "types": "./dist/element-define.d.ts",
      "import": "./dist/element-define.js",
      "default": "./dist/element-define.js"
    },
    "./presets": {
      "types": "./dist/presets-entry.d.ts",
      "import": "./dist/presets-entry.js",
      "default": "./dist/presets-entry.js"
    },
    "./presets/*": {
      "types": "./dist/presets/*.d.ts",
      "import": "./dist/presets/*.js",
      "default": "./dist/presets/*.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "node --test test/*.test.ts",
    "test:package": "pnpm build && node scripts/check-package.mjs",
    "test:readme": "pnpm build && node scripts/make-presets-doc.mjs --check && node scripts/check-readme-examples.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && node scripts/check-package.mjs",
    "prepublishOnly": "pnpm check",
    "family:readme": "node scripts/family-readme.mjs",
    "dev": "pnpm build && node scripts/dev.mjs",
    "presets:doc": "pnpm build && node scripts/make-presets-doc.mjs",
    "site": "pnpm build && node scripts/site.mjs",
    "test:demo": "pnpm site && node scripts/docs-site.mjs build && playwright test",
    "test:freeze": "pnpm site && playwright test e2e/freeze.demo.mjs --project=chromium-desk",
    "screenshots": "pnpm site && node scripts/screenshots.mjs",
    "animations": "pnpm build && node scripts/animations.mjs",
    "sheets": "pnpm build && node scripts/sheets.mjs",
    "mode-icons": "pnpm build && node scripts/mode-icons.mjs",
    "belt-box-sheet": "pnpm build && node scripts/belt-box-sheet.mjs",
    "belt-sheets": "pnpm build && node scripts/belt-sheets.mjs",
    "test:usage": "pnpm site && node scripts/check-usage.mjs",
    "docs:site": "pnpm build && node scripts/docs-site.mjs build",
    "docs:check": "pnpm build && node scripts/docs-site.mjs check",
    "size": "node scripts/docs-site.mjs size",
    "check:standard": "node scripts/check-standard.mjs"
  },
  "devDependencies": {
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@eslint/js": "^9.0.0",
    "@johnmorrisdotca/kazoku-ui": "^0.7.3",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "marked": "^18.1.3",
    "pagefind": "^1.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rxjs": "^7.8.2",
    "svelte": "^5.57.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.5",
    "vue": "^3.5.44",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.15.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
