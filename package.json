{
  "name": "@johnmorrisdotca/senshu-jerseys",
  "version": "0.5.3",
  "description": "Senshu Jerseys 選手, sports jerseys, sweaters, kits, caps, helmets and retired-number banners as SVG strings: hockey, baseball, basketball, football, soccer, rugby and handball cuts, front and back, in stripes, hoops, halves and pinstripes, with numbers and names drawn as vectors, optional 2.5D turning and a custom element. Zero dependencies.",
  "keywords": [
    "jersey",
    "sweater",
    "kit",
    "uniform",
    "sports",
    "hockey",
    "baseball",
    "basketball",
    "football",
    "soccer",
    "rugby",
    "cap",
    "helmet",
    "retired-number",
    "banner",
    "svg",
    "turntable",
    "custom-element",
    "web-component",
    "accessible",
    "typescript",
    "javascript",
    "zero-dependencies",
    "browser",
    "node",
    "itsutsu"
  ],
  "homepage": "https://johnmorrisdotca.github.io/senshu-jerseys/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnmorrisdotca/senshu-jerseys.git"
  },
  "bugs": {
    "url": "https://github.com/johnmorrisdotca/senshu-jerseys/issues"
  },
  "author": "John Morris",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/element-define.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./turn": {
      "types": "./dist/turn-entry.d.ts",
      "import": "./dist/turn-entry.js",
      "default": "./dist/turn-entry.js"
    },
    "./element": {
      "types": "./dist/element-entry.d.ts",
      "import": "./dist/element-entry.js",
      "default": "./dist/element-entry.js"
    },
    "./define": {
      "types": "./dist/element-define.d.ts",
      "import": "./dist/element-define.js",
      "default": "./dist/element-define.js"
    },
    "./presets": {
      "types": "./dist/presets-entry.d.ts",
      "import": "./dist/presets-entry.js",
      "default": "./dist/presets-entry.js"
    },
    "./presets/*": {
      "types": "./dist/presets/*.d.ts",
      "import": "./dist/presets/*.js",
      "default": "./dist/presets/*.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "node --test test/*.test.ts",
    "test:package": "pnpm build && node scripts/check-package.mjs",
    "test:readme": "pnpm build && node scripts/make-presets-doc.mjs --check && node scripts/check-readme-examples.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && node scripts/check-package.mjs",
    "prepublishOnly": "pnpm check",
    "family:readme": "node scripts/family-readme.mjs",
    "dev": "pnpm build && node scripts/dev.mjs",
    "presets:doc": "pnpm build && node scripts/make-presets-doc.mjs",
    "site": "pnpm build && node scripts/site.mjs",
    "test:demo": "pnpm site && playwright test",
    "screenshots": "pnpm site && node scripts/screenshots.mjs",
    "sheets": "pnpm build && node scripts/sheets.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.11.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
